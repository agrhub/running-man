    "@fontsource/baloo-2": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@hono/node-server": "2.1.6",
    "devvit": "0.15.3",
    "express": "5.3.0",
    "hono": "4.13.17",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
